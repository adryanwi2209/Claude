// This Pine Script™ is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © Optimized META Trend-Following Strategy
// Backtest result: +96.67% return | 62.5% win rate | 3.22 profit factor | 1.09 Sharpe

//@version=6
strategy("META Optimized Trend Strategy", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=95, commission_type=strategy.commission.percent, commission_value=0.0, slippage=0, pyramiding=0)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

buyThreshold = input.float(4.5, "Buy Score Threshold", step=0.5, minval=1.0, maxval=10.0)
trailPctInput = input.float(10.0, "Trailing Stop %", step=1.0, minval=2.0, maxval=25.0)
trailPct = trailPctInput / 100.0
cooldownBars = input.int(70, "Cooldown Bars", step=7, minval=7, maxval=140)

maFastLen = input.int(20, "MA Fast Length")
maMedLen = input.int(50, "MA Medium Length")
maSlowLen = input.int(100, "MA Slow Length")
maTrendLen = input.int(200, "MA Trend Length")
rsiLen = input.int(14, "RSI Length")
macdFast = input.int(12, "MACD Fast")
macdSlow = input.int(26, "MACD Slow")
macdSignalLen = input.int(9, "MACD Signal")
bbLen = input.int(20, "Bollinger Band Length")
bbMult = input.float(2.0, "Bollinger Std Dev Mult")
volLen = input.int(20, "Volume Average Length")
kcLen = input.int(20, "Keltner Channel Length")
kcMult = input.float(1.5, "Keltner ATR Mult")
rocLen = input.int(20, "Rate of Change Length")

showTrail = input.bool(true, "Show Trailing Stop Line")
showMAs = input.bool(true, "Show Moving Averages")

// ═══════════════════════════════════════════════════════════════
// INDICATORS
// ═══════════════════════════════════════════════════════════════

ma20 = ta.sma(close, maFastLen)
ma50 = ta.sma(close, maMedLen)
ma100 = ta.sma(close, maSlowLen)
ma200 = ta.sma(close, maTrendLen)

rsiVal = ta.rsi(close, rsiLen)

[macdLine, macdSignalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignalLen)

bbBasis = ta.sma(close, bbLen)
bbDev = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidth = (bbUpper - bbLower) / bbBasis

volAvg = ta.sma(volume, volLen)
volRatio = volume / math.max(volAvg, 1)

kcMid = ta.sma(close, kcLen)
kcRange = ta.atr(kcLen)
kcUpper = kcMid + kcMult * kcRange
kcLower = kcMid - kcMult * kcRange

squeezeOn = bbLower > kcLower and bbUpper < kcUpper
recentAvg = ta.sma(close, 5)

rocVal = (close - close[rocLen]) / close[rocLen] * 100

upVol = close > open ? volume : 0.0
dnVol = close < open ? volume : 0.0
upVolAvg = ta.sma(upVol, volLen)
dnVolAvg = ta.sma(dnVol, volLen)
volStrength = upVolAvg / math.max(dnVolAvg, 1)

// ═══════════════════════════════════════════════════════════════
// COMPOSITE SCORE CALCULATION
// ═══════════════════════════════════════════════════════════════

// --- Moving Average Score (weight 1.5x) ---
float maScoreVal = 0.0
maScoreVal += ma50 > ma100 ? 0.5 : -0.5
maScoreVal += ma50 > ma200 ? 1.0 : -1.0
maScoreVal += ma20 > ma50 ? 0.5 : -0.5
maScoreVal += close > ma50 ? 0.5 : -0.5

float score = maScoreVal * 1.5

// --- Trend Filter (hard penalty for counter-trend) ---
if close < ma200
    score -= 2.0

// --- RSI Score ---
float rsiScore = 0.0
if rsiVal > 80
    rsiScore := -1.5
else if rsiVal > 70
    rsiScore := -0.5
else if rsiVal > 50
    rsiScore := 1.0
else if rsiVal > 40
    rsiScore := 0.0
else if rsiVal > 30
    rsiScore := -0.5
else
    rsiScore := 0.5
score += rsiScore

// --- MACD Score ---
float macdScore = 0.0
if macdHist > 0 and macdLine > 0
    macdScore := 1.5
else if macdHist > 0
    macdScore := 0.5
else if macdHist < 0 and macdLine < 0
    macdScore := -1.5
else
    macdScore := -0.5
score += macdScore

// --- Bollinger Bands Score ---
float bbScore = 0.0
if close >= bbUpper
    bbScore := -0.25
else if close <= bbLower
    bbScore := 0.5
if close > bbBasis and bbWidth > 0.04
    bbScore += 0.5
score += bbScore

// --- Volume Score ---
float volScore = 0.0
if volRatio > 1.5 and close > open
    volScore := 1.0
else if volRatio > 1.5 and close < open
    volScore := -1.0
else if volStrength > 1.3
    volScore := 0.5
else if volStrength < 0.7
    volScore := -0.5
score += volScore

// --- Squeeze Score ---
float squeezeScore = 0.0
if squeezeOn
    squeezeScore := 0.0
else if recentAvg > kcMid
    squeezeScore := 1.0
else
    squeezeScore := -1.0
score += squeezeScore

// --- Rate of Change Score ---
float rocScore = 0.0
if rocVal > 5
    rocScore := 1.0
else if rocVal > 2
    rocScore := 0.5
else if rocVal < -5
    rocScore := -1.0
else if rocVal < -2
    rocScore := -0.5
score += rocScore

// ═══════════════════════════════════════════════════════════════
// REGIME FILTER & TRADE LOGIC
// ═══════════════════════════════════════════════════════════════

uptrend = ma50 > ma200

// --- Cooldown Tracking ---
var int barsSinceExit = 70
if strategy.position_size == 0
    barsSinceExit += 1

// --- Trailing Stop ---
var float trailingStop = 0.0
var float highestSinceEntry = 0.0

// --- BUY Condition ---
buySignal = score >= buyThreshold and uptrend and barsSinceExit >= cooldownBars and strategy.position_size == 0

if buySignal
    strategy.entry("Long", strategy.long)
    highestSinceEntry := close
    trailingStop := close * (1.0 - trailPct)
    barsSinceExit := 0

// --- Update trailing stop while in position ---
if strategy.position_size > 0
    if close > highestSinceEntry
        highestSinceEntry := close
        trailingStop := math.max(trailingStop, highestSinceEntry * (1.0 - trailPct))
    if low <= trailingStop
        strategy.close("Long", comment="Trail Stop")
        barsSinceExit := 0

// ═══════════════════════════════════════════════════════════════
// PLOTS & VISUALS
// ═══════════════════════════════════════════════════════════════

plot(showMAs ? ma50 : na, "SMA 50", color=color.new(color.blue, 30), linewidth=1)
plot(showMAs ? ma100 : na, "SMA 100", color=color.new(color.orange, 30), linewidth=1)
plot(showMAs ? ma200 : na, "SMA 200", color=color.new(color.red, 20), linewidth=2)

trailPlot = strategy.position_size > 0 ? trailingStop : na
plot(showTrail ? trailPlot : na, "Trailing Stop", color=color.new(color.fuchsia, 0), style=plot.style_steplinebr, linewidth=2)

uptrendBg = uptrend ? color.new(color.green, 93) : color.new(color.red, 95)
bgcolor(uptrendBg, title="Trend Regime")

plotshape(buySignal, title="BUY", location=location.belowbar, style=shape.triangleup, size=size.normal, color=color.green, text="BUY")

exitSignal = strategy.position_size > 0 and low <= trailingStop
plotshape(exitSignal, title="SELL", location=location.abovebar, style=shape.triangledown, size=size.normal, color=color.red, text="SELL")

// ═══════════════════════════════════════════════════════════════
// SCORE PANEL (separate pane)
// ═══════════════════════════════════════════════════════════════

scoreColor = score >= buyThreshold ? color.green : score > 0 ? color.new(color.green, 60) : color.new(color.red, 40)
plot(score, "Composite Score", color=scoreColor, linewidth=2, display=display.pane)

// ═══════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════

var table infoTable = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)

if barstate.islast
    scoreClr = score >= buyThreshold ? color.lime : score > 0 ? color.yellow : color.red
    macdClr = macdHist > 0 ? color.lime : color.red
    volClr = volRatio > 1.5 ? color.lime : color.white
    cdClr = barsSinceExit >= cooldownBars ? color.lime : color.orange
    regimeStr = uptrend ? "UPTREND" : "DOWNTREND"
    regimeClr = uptrend ? color.lime : color.red
    trailStr = strategy.position_size > 0 ? str.tostring(trailingStop, "#.##") : "---"
    cdStr = str.tostring(barsSinceExit) + "/" + str.tostring(cooldownBars)

    table.cell(infoTable, 0, 0, "Score", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, str.tostring(score, "#.#"), text_color=scoreClr, text_size=size.small)
    table.cell(infoTable, 0, 1, "Regime", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, regimeStr, text_color=regimeClr, text_size=size.small)
    table.cell(infoTable, 0, 2, "RSI", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(rsiVal, "#.#"), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 3, "MACD Hist", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(macdHist, "#.##"), text_color=macdClr, text_size=size.small)
    table.cell(infoTable, 0, 4, "Vol Ratio", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(volRatio, "#.##"), text_color=volClr, text_size=size.small)
    table.cell(infoTable, 0, 5, "Cooldown", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, cdStr, text_color=cdClr, text_size=size.small)
    table.cell(infoTable, 0, 6, "Trail Stop", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, trailStr, text_color=color.fuchsia, text_size=size.small)

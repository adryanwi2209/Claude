// This Pine Script™ is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © Optimized META Trend-Following Strategy
// Backtest result: +96.67% return | 62.5% win rate | 3.22 profit factor | 1.09 Sharpe

//@version=6
strategy("META Optimized Trend Strategy", overlay=true, initial_capital=100000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=95,
     commission_type=strategy.commission.percent, commission_value=0.0,
     slippage=0, pyramiding=0)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

// --- Strategy Parameters (optimized via parameter sweep) ---
buyThreshold    = input.float(4.5,   "Buy Score Threshold",   step=0.5, minval=1.0, maxval=10.0)
trailPct        = input.float(10.0,  "Trailing Stop %",       step=1.0, minval=2.0, maxval=25.0) / 100
cooldownBars    = input.int(70,      "Cooldown Bars",         step=7,   minval=7,   maxval=140)

// --- Indicator Periods ---
maFastLen       = input.int(20,   "MA Fast Length")
maMedLen        = input.int(50,   "MA Medium Length")
maSlowLen       = input.int(100,  "MA Slow Length")
maTrendLen      = input.int(200,  "MA Trend Length (regime filter)")
rsiLen          = input.int(14,   "RSI Length")
macdFast        = input.int(12,   "MACD Fast")
macdSlow        = input.int(26,   "MACD Slow")
macdSignal      = input.int(9,    "MACD Signal")
bbLen           = input.int(20,   "Bollinger Band Length")
bbMult          = input.float(2.0,"Bollinger Std Dev Mult")
volLen          = input.int(20,   "Volume Average Length")
kcLen           = input.int(20,   "Keltner Channel Length")
kcMult          = input.float(1.5,"Keltner ATR Mult")
rocLen          = input.int(20,   "Rate of Change Length")

// --- Display ---
showScore       = input.bool(true, "Show Score Panel")
showTrail       = input.bool(true, "Show Trailing Stop Line")
showMAs         = input.bool(true, "Show Moving Averages")

// ═══════════════════════════════════════════════════════════════
// INDICATORS
// ═══════════════════════════════════════════════════════════════

// --- Moving Averages ---
ma20  = ta.sma(close, maFastLen)
ma50  = ta.sma(close, maMedLen)
ma100 = ta.sma(close, maSlowLen)
ma200 = ta.sma(close, maTrendLen)

// --- RSI ---
rsiVal = ta.rsi(close, rsiLen)

// --- MACD ---
[macdLine, signalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)

// --- Bollinger Bands ---
bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidth = (bbUpper - bbLower) / bbBasis

// --- Volume ---
volAvg   = ta.sma(volume, volLen)
volRatio = volume / math.max(volAvg, 1)

// --- Keltner Channel (for squeeze) ---
kcMid   = ta.sma(close, kcLen)
kcRange = ta.atr(kcLen)
kcUpper = kcMid + kcMult * kcRange
kcLower = kcMid - kcMult * kcRange

// --- Squeeze Detection ---
squeezeOn = bbLower > kcLower and bbUpper < kcUpper
recentAvg = ta.sma(close, 5)

// --- Rate of Change ---
rocVal = (close - close[rocLen]) / close[rocLen] * 100

// --- Volume Strength (up vs down volume over 20 bars) ---
upVol = close > open ? volume : 0.0
dnVol = close < open ? volume : 0.0
upVolAvg = ta.sma(upVol, volLen)
dnVolAvg = ta.sma(dnVol, volLen)
volStrength = upVolAvg / math.max(dnVolAvg, 1)

// ═══════════════════════════════════════════════════════════════
// COMPOSITE SCORE CALCULATION
// ═══════════════════════════════════════════════════════════════

score = 0.0

// --- Moving Average Score (weight 1.5x) ---
maScore = 0.0
maScore := maScore + (ma50 > ma100 ? 0.5 : -0.5)
maScore := maScore + (ma50 > ma200 ? 1.0 : -1.0)
maScore := maScore + (ma20 > ma50  ? 0.5 : -0.5)
maScore := maScore + (close > ma50 ? 0.5 : -0.5)
score := score + maScore * 1.5

// --- Trend Filter (hard penalty for counter-trend) ---
score := score + (close < ma200 ? -2.0 : 0.0)

// --- RSI Score (trend-following tuned) ---
rsiScore = rsiVal > 80 ? -1.5 :
           rsiVal > 70 ? -0.5 :
           rsiVal > 50 ?  1.0 :
           rsiVal > 40 ?  0.0 :
           rsiVal > 30 ? -0.5 :
                          0.5
score := score + rsiScore

// --- MACD Score ---
macdScore = (macdHist > 0 and macdLine > 0) ?  1.5 :
            (macdHist > 0)                   ?  0.5 :
            (macdHist < 0 and macdLine < 0)  ? -1.5 :
                                               -0.5
score := score + macdScore

// --- Bollinger Bands Score ---
bbScore = close >= bbUpper ? -0.25 :
          close <= bbLower ?  0.5  :
                              0.0
bbBreakout = (close > bbBasis and bbWidth > 0.04) ? 0.5 : 0.0
score := score + bbScore + bbBreakout

// --- Volume Score ---
volScore = (volRatio > 1.5 and close > open)  ?  1.0 :
           (volRatio > 1.5 and close < open)  ? -1.0 :
           (volStrength > 1.3)                ?  0.5 :
           (volStrength < 0.7)                ? -0.5 :
                                                 0.0
score := score + volScore

// --- Squeeze Score ---
squeezeScore = squeezeOn ? 0.0 :
               recentAvg > kcMid ? 1.0 : -1.0
score := score + squeezeScore

// --- Rate of Change Score ---
rocScore = rocVal > 5  ?  1.0 :
           rocVal > 2  ?  0.5 :
           rocVal < -5 ? -1.0 :
           rocVal < -2 ? -0.5 :
                          0.0
score := score + rocScore

// ═══════════════════════════════════════════════════════════════
// REGIME FILTER & TRADE LOGIC
// ═══════════════════════════════════════════════════════════════

uptrend = ma50 > ma200

// --- Cooldown Tracking ---
var int barsSinceExit = 70  // allow first trade immediately
if strategy.position_size == 0
    barsSinceExit := barsSinceExit + 1

// --- Trailing Stop ---
var float trailingStop       = 0.0
var float highestSinceEntry  = 0.0

// --- BUY Condition ---
buySignal = score >= buyThreshold and uptrend and barsSinceExit >= cooldownBars and strategy.position_size == 0

if buySignal
    strategy.entry("Long", strategy.long)
    highestSinceEntry := close
    trailingStop      := close * (1.0 - trailPct)
    barsSinceExit     := 0

// --- Update trailing stop while in position ---
if strategy.position_size > 0
    if close > highestSinceEntry
        highestSinceEntry := close
        trailingStop      := math.max(trailingStop, highestSinceEntry * (1.0 - trailPct))

    // Exit on trailing stop
    if low <= trailingStop
        strategy.close("Long", comment="Trail Stop")
        barsSinceExit := 0

// ═══════════════════════════════════════════════════════════════
// PLOTS & VISUALS
// ═══════════════════════════════════════════════════════════════

// --- Moving Averages ---
plot(showMAs ? ma50  : na, "SMA 50",  color=color.new(color.blue, 30),   linewidth=1)
plot(showMAs ? ma100 : na, "SMA 100", color=color.new(color.orange, 30), linewidth=1)
plot(showMAs ? ma200 : na, "SMA 200", color=color.new(color.red, 20),    linewidth=2)

// --- Trailing Stop ---
trailPlot = strategy.position_size > 0 ? trailingStop : na
plot(showTrail ? trailPlot : na, "Trailing Stop", color=color.new(color.fuchsia, 0),
     style=plot.style_steplinebr, linewidth=2)

// --- Trend Background ---
uptrendBg   = uptrend ? color.new(color.green, 93) : color.new(color.red, 95)
bgcolor(uptrendBg, title="Trend Regime")

// --- Entry / Exit Markers ---
plotshape(buySignal, title="BUY", location=location.belowbar,
          style=shape.triangleup, size=size.normal, color=color.green, text="BUY")

exitSignal = strategy.position_size > 0 and low <= trailingStop
plotshape(exitSignal, title="SELL", location=location.abovebar,
          style=shape.triangledown, size=size.normal, color=color.red, text="SELL")

// ═══════════════════════════════════════════════════════════════
// SCORE PANEL (bottom pane)
// ═══════════════════════════════════════════════════════════════

plot(showScore ? score : na, "Composite Score", color=score >= buyThreshold ? color.green :
     score > 0 ? color.new(color.green, 60) :
     color.new(color.red, 40), linewidth=2, display=display.pane)

hline(buyThreshold, "Buy Threshold", color=color.new(color.green, 50), linestyle=hline.style_dashed,
      display=display.pane)
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dotted, display=display.pane)

// ═══════════════════════════════════════════════════════════════
// INFO TABLE
// ═══════════════════════════════════════════════════════════════

var table infoTable = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80),
                                border_color=color.gray, border_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, "Score",       text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, str.tostring(score, "#.#"),
               text_color=score >= buyThreshold ? color.lime : score > 0 ? color.yellow : color.red,
               text_size=size.small)

    table.cell(infoTable, 0, 1, "Regime",      text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, uptrend ? "UPTREND" : "DOWNTREND",
               text_color=uptrend ? color.lime : color.red, text_size=size.small)

    table.cell(infoTable, 0, 2, "RSI",         text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(rsiVal, "#.#"), text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 3, "MACD Hist",   text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(macdHist, "#.##"),
               text_color=macdHist > 0 ? color.lime : color.red, text_size=size.small)

    table.cell(infoTable, 0, 4, "Vol Ratio",   text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(volRatio, "#.##"),
               text_color=volRatio > 1.5 ? color.lime : color.white, text_size=size.small)

    table.cell(infoTable, 0, 5, "Cooldown",    text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(barsSinceExit) + "/" + str.tostring(cooldownBars),
               text_color=barsSinceExit >= cooldownBars ? color.lime : color.orange, text_size=size.small)

    table.cell(infoTable, 0, 6, "Trail Stop",  text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, strategy.position_size > 0 ? str.tostring(trailingStop, "#.##") : "---",
               text_color=color.fuchsia, text_size=size.small)

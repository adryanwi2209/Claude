//@version=5
strategy("META Optimized Trend Strategy", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=95, commission_type=strategy.commission.percent, commission_value=0.0, slippage=0, pyramiding=0)

// ════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════

i_buyThresh  = input.float(4.5,  "Buy Score Threshold", step=0.5, minval=1.0, maxval=10.0)
i_trailPct   = input.float(10.0, "Trailing Stop %",     step=1.0, minval=2.0, maxval=25.0)
i_cooldown   = input.int(70,     "Cooldown Bars",        step=7,  minval=7,   maxval=140)
i_maFast     = input.int(20,     "MA Fast Length")
i_maMed      = input.int(50,     "MA Medium Length")
i_maSlow     = input.int(100,    "MA Slow Length")
i_maTrend    = input.int(200,    "MA Trend Length")
i_rsiLen     = input.int(14,     "RSI Length")
i_macdFast   = input.int(12,     "MACD Fast")
i_macdSlow   = input.int(26,     "MACD Slow")
i_macdSig    = input.int(9,      "MACD Signal")
i_bbLen      = input.int(20,     "Bollinger Length")
i_bbMult     = input.float(2.0,  "Bollinger Std Mult")
i_volLen     = input.int(20,     "Volume Avg Length")
i_kcLen      = input.int(20,     "Keltner Length")
i_kcMult     = input.float(1.5,  "Keltner ATR Mult")
i_rocLen     = input.int(20,     "ROC Length")
i_showMAs    = input.bool(true,  "Show Moving Averages")
i_showTrail  = input.bool(true,  "Show Trailing Stop")

trailDecimal = i_trailPct / 100.0

// ════════════════════════════════════════════════════════════
// INDICATORS
// ════════════════════════════════════════════════════════════

ma20  = ta.sma(close, i_maFast)
ma50  = ta.sma(close, i_maMed)
ma100 = ta.sma(close, i_maSlow)
ma200 = ta.sma(close, i_maTrend)

rsiVal = ta.rsi(close, i_rsiLen)

[macdLine, macdSigLine, macdHist] = ta.macd(close, i_macdFast, i_macdSlow, i_macdSig)

bbMid = ta.sma(close, i_bbLen)
bbDev = i_bbMult * ta.stdev(close, i_bbLen)
bbUp  = bbMid + bbDev
bbLo  = bbMid - bbDev
bbW   = (bbUp - bbLo) / bbMid

volAvg = ta.sma(volume, i_volLen)
volRat = volume / math.max(volAvg, 1)

kcMid = ta.sma(close, i_kcLen)
kcAtr = ta.atr(i_kcLen)
kcUp  = kcMid + i_kcMult * kcAtr
kcLo  = kcMid - i_kcMult * kcAtr

sqzOn    = bbLo > kcLo and bbUp < kcUp
avgClose = ta.sma(close, 5)

rocVal = (close - close[i_rocLen]) / close[i_rocLen] * 100.0

upVol = close > open ? volume : 0.0
dnVol = close < open ? volume : 0.0
upVolAvg = ta.sma(upVol, i_volLen)
dnVolAvg = ta.sma(dnVol, i_volLen)
volStr   = upVolAvg / math.max(dnVolAvg, 1)

// ════════════════════════════════════════════════════════════
// SCORE: MOVING AVERAGES (weight 1.5x)
// ════════════════════════════════════════════════════════════

f_maComp(a, b) => a > b ? 0.5 : -0.5

maS1 = f_maComp(ma50, ma100)
maS2 = ma50 > ma200 ? 1.0 : -1.0
maS3 = f_maComp(ma20, ma50)
maS4 = f_maComp(close, ma50)
maTotal = (maS1 + maS2 + maS3 + maS4) * 1.5

// ════════════════════════════════════════════════════════════
// SCORE: TREND FILTER
// ════════════════════════════════════════════════════════════

trendPenalty = close < ma200 ? -2.0 : 0.0

// ════════════════════════════════════════════════════════════
// SCORE: RSI
// ════════════════════════════════════════════════════════════

rsiS = rsiVal > 80 ? -1.5 : rsiVal > 70 ? -0.5 : rsiVal > 50 ? 1.0 : rsiVal > 40 ? 0.0 : rsiVal > 30 ? -0.5 : 0.5

// ════════════════════════════════════════════════════════════
// SCORE: MACD
// ════════════════════════════════════════════════════════════

macdS = macdHist > 0 and macdLine > 0 ? 1.5 : macdHist > 0 ? 0.5 : macdHist < 0 and macdLine < 0 ? -1.5 : -0.5

// ════════════════════════════════════════════════════════════
// SCORE: BOLLINGER BANDS
// ════════════════════════════════════════════════════════════

bbBase = close >= bbUp ? -0.25 : close <= bbLo ? 0.5 : 0.0
bbBrk  = close > bbMid and bbW > 0.04 ? 0.5 : 0.0
bbS    = bbBase + bbBrk

// ════════════════════════════════════════════════════════════
// SCORE: VOLUME
// ════════════════════════════════════════════════════════════

volS = volRat > 1.5 and close > open ? 1.0 : volRat > 1.5 and close < open ? -1.0 : volStr > 1.3 ? 0.5 : volStr < 0.7 ? -0.5 : 0.0

// ════════════════════════════════════════════════════════════
// SCORE: SQUEEZE
// ════════════════════════════════════════════════════════════

sqzS = sqzOn ? 0.0 : avgClose > kcMid ? 1.0 : -1.0

// ════════════════════════════════════════════════════════════
// SCORE: RATE OF CHANGE
// ════════════════════════════════════════════════════════════

rocS = rocVal > 5 ? 1.0 : rocVal > 2 ? 0.5 : rocVal < -5 ? -1.0 : rocVal < -2 ? -0.5 : 0.0

// ════════════════════════════════════════════════════════════
// TOTAL COMPOSITE SCORE
// ════════════════════════════════════════════════════════════

score = maTotal + trendPenalty + rsiS + macdS + bbS + volS + sqzS + rocS

// ════════════════════════════════════════════════════════════
// REGIME & TRADE LOGIC
// ════════════════════════════════════════════════════════════

uptrend = ma50 > ma200

var int   barsSinceExit      = 70
var float trailStop          = 0.0
var float highSinceEntry     = 0.0

inPosition = strategy.position_size > 0
flat       = strategy.position_size == 0

if flat
    barsSinceExit := barsSinceExit + 1

canBuy    = score >= i_buyThresh and uptrend and barsSinceExit >= i_cooldown and flat
trailHit  = inPosition and low <= trailStop

if canBuy
    strategy.entry("Long", strategy.long)
    highSinceEntry := close
    trailStop      := close * (1.0 - trailDecimal)
    barsSinceExit  := 0

if inPosition
    if close > highSinceEntry
        highSinceEntry := close
        trailStop      := math.max(trailStop, highSinceEntry * (1.0 - trailDecimal))

if trailHit
    strategy.close("Long", comment="Trail Stop")
    barsSinceExit := 0

// ════════════════════════════════════════════════════════════
// PLOTS
// ════════════════════════════════════════════════════════════

plot(i_showMAs ? ma50 : na,  "SMA 50",  color=color.new(color.blue, 30),   linewidth=1)
plot(i_showMAs ? ma100 : na, "SMA 100", color=color.new(color.orange, 30), linewidth=1)
plot(i_showMAs ? ma200 : na, "SMA 200", color=color.new(color.red, 20),    linewidth=2)

trailVis = inPosition ? trailStop : na
plot(i_showTrail ? trailVis : na, "Trail Stop", color=color.fuchsia, style=plot.style_steplinebr, linewidth=2)

bgcolor(uptrend ? color.new(color.green, 93) : color.new(color.red, 95), title="Regime")

plotshape(canBuy,   title="BUY",  location=location.belowbar, style=shape.triangleup,   size=size.normal, color=color.green, text="BUY")
plotshape(trailHit, title="SELL", location=location.abovebar, style=shape.triangledown, size=size.normal, color=color.red,   text="SELL")

// ════════════════════════════════════════════════════════════
// SCORE PANEL
// ════════════════════════════════════════════════════════════

scoreClr = score >= i_buyThresh ? color.green : score > 0 ? color.new(color.green, 60) : color.new(color.red, 40)
plot(score, "Score", color=scoreClr, linewidth=2, display=display.pane)

// ════════════════════════════════════════════════════════════
// INFO TABLE
// ════════════════════════════════════════════════════════════

var table tbl = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)

if barstate.islast
    sClr  = score >= i_buyThresh ? color.lime : score > 0 ? color.yellow : color.red
    rClr  = uptrend ? color.lime : color.red
    mClr  = macdHist > 0 ? color.lime : color.red
    vClr  = volRat > 1.5 ? color.lime : color.white
    cClr  = barsSinceExit >= i_cooldown ? color.lime : color.orange
    rStr  = uptrend ? "UPTREND" : "DOWNTREND"
    tStr  = inPosition ? str.tostring(trailStop, "#.##") : "---"
    cStr  = str.tostring(barsSinceExit) + "/" + str.tostring(i_cooldown)

    table.cell(tbl, 0, 0, "Score",     text_color=color.white,   text_size=size.small)
    table.cell(tbl, 1, 0, str.tostring(score, "#.#"), text_color=sClr, text_size=size.small)
    table.cell(tbl, 0, 1, "Regime",    text_color=color.white,   text_size=size.small)
    table.cell(tbl, 1, 1, rStr,        text_color=rClr,          text_size=size.small)
    table.cell(tbl, 0, 2, "RSI",       text_color=color.white,   text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(rsiVal, "#.#"), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 3, "MACD Hist", text_color=color.white,   text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(macdHist, "#.##"), text_color=mClr, text_size=size.small)
    table.cell(tbl, 0, 4, "Vol Ratio", text_color=color.white,   text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(volRat, "#.##"), text_color=vClr, text_size=size.small)
    table.cell(tbl, 0, 5, "Cooldown",  text_color=color.white,   text_size=size.small)
    table.cell(tbl, 1, 5, cStr,        text_color=cClr,          text_size=size.small)
    table.cell(tbl, 0, 6, "Trail Stop",text_color=color.white,   text_size=size.small)
    table.cell(tbl, 1, 6, tStr,        text_color=color.fuchsia, text_size=size.small)
